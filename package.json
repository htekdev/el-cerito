{
  "name": "el-cerito",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --run coverage:prepare && node --test --experimental-test-coverage --test-coverage-include=src/lib/nutrition.ts --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "coverage:prepare": "node --input-type=module -e \"import {mkdirSync} from 'node:fs'; mkdirSync('coverage', {recursive:true})\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.6",
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/nunito-sans": "^5.2.5",
    "@tailwindcss/vite": "4.1",
    "astro": "^6.2.2",
    "openai": "^4.104.0",
    "tailwindcss": "4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "js-yaml": "4.3.2",
    "parse5": "7.3.0",
    "sharp": "^0.34.5"
  }
}
