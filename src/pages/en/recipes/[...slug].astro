---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecipeDetail from '../../../components/sections/RecipeDetail.astro';
import { rTitle, rDescription } from '../../../i18n/utils';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes', ({ data }) => !data.draft);
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const d = recipe.data;
---
<BaseLayout
  title={rTitle(d, 'en')}
  description={rDescription(d, 'en')}
  ogImage={d.coverImage}
  ogType="article"
  lang="en"
  altLangUrl={`/recetas/${recipe.id}`}
>
  <RecipeDetail entry={recipe} lang="en" />
</BaseLayout>
