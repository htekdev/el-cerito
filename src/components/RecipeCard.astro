---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, HEALTH_LABELS, categoryLabel, healthLabel, formatMinutes, totalTime } from '../lib/nutrition';
import { useTranslations, recipePath, rTitle, rDescription } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'recipes'>;
  lang?: Lang;
}
const { entry, lang = 'es' } = Astro.props;
const d = entry.data;
const t = useTranslations(lang);

const title = rTitle(d, lang);
const description = rDescription(d, lang);
const href = recipePath(lang, entry.id);
const time = totalTime(d.prepTime, d.cookTime, d.totalTime);
const primaryCat = d.categories[0];
---
<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-2xl bg-white border border-clay shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-clay">
    <img
      src={d.coverImage}
      alt={d.coverImageAlt || title}
      loading="lazy"
      class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    {d.ranchOriginal && (
      <span class="absolute top-3 left-3 rounded-full bg-earth/85 text-cream text-[11px] font-semibold px-2.5 py-1 backdrop-blur">
        🌾 {t('card.fromRanch')}
      </span>
    )}
    {primaryCat && CATEGORIES[primaryCat] && (
      <span class="absolute top-3 right-3 rounded-full bg-cream/90 text-earth text-[11px] font-semibold px-2.5 py-1 backdrop-blur">
        {CATEGORIES[primaryCat].icon} {categoryLabel(primaryCat, lang)}
      </span>
    )}
  </div>

  <div class="flex flex-col flex-1 p-5">
    <h3 class="font-heading text-lg font-bold text-earth leading-snug group-hover:text-terracotta-dark transition-colors">
      {title}
    </h3>
    <p class="mt-1.5 text-sm text-earth-soft line-clamp-2 flex-1">{description}</p>

    {d.healthLabels.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {d.healthLabels.slice(0, 3).map((label) => HEALTH_LABELS[label] && (
          <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-semibold', HEALTH_LABELS[label].color]}>
            {healthLabel(label, lang)}
          </span>
        ))}
      </div>
    )}

    <div class="mt-4 flex items-center justify-between text-xs text-earth-soft border-t border-clay/70 pt-3">
      <span class="inline-flex items-center gap-1">⏱️ {formatMinutes(time)}</span>
      <span class="inline-flex items-center gap-1">🔥 {d.macros.calories} kcal</span>
      <span class="inline-flex items-center gap-1">💪 {d.macros.protein} g</span>
    </div>
  </div>
</a>
