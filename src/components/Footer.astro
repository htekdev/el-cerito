---
import Logo from './Logo.astro';
import { useTranslations, routes } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const r = routes(lang);
const year = new Date().getFullYear();
---
<footer class="mt-20 bg-earth text-cream/80">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 grid gap-8 sm:grid-cols-3">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <Logo class="h-9 w-9" title="" />
        <span class="font-heading text-xl font-bold text-cream">{t('nav.brand')}</span>
      </div>
      <p class="text-sm leading-relaxed text-cream/70">
        {t('site.tagline')}
      </p>
    </div>

    <div>
      <h3 class="font-heading text-cream text-base mb-3">{t('footer.explore')}</h3>
      <ul class="space-y-2 text-sm">
        <li><a href={r.recipes} class="hover:text-terracotta-light transition-colors">{t('footer.allRecipes')}</a></li>
        <li><a href={r.healthy} class="hover:text-terracotta-light transition-colors">{t('footer.healthyOptions')}</a></li>
        <li><a href={r.about} class="hover:text-terracotta-light transition-colors">{t('footer.aboutRanch')}</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-heading text-cream text-base mb-3">{t('footer.ranch')}</h3>
      <p class="text-sm text-cream/70 leading-relaxed">
        <Fragment set:html={t('footer.location')} />
        <span class="text-cream/50">{t('footer.madeBy')}</span>
      </p>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-4 text-xs text-cream/50 flex flex-col sm:flex-row justify-between items-center gap-2">
      <p>© {year} {t('footer.copyright')}</p>
      <a
        href={r.addRecipe}
        rel="nofollow"
        class="inline-flex items-center gap-1 text-cream/60 hover:text-terracotta-light transition-colors"
        title={t('footer.addRecipeHint')}
      >
        <span aria-hidden="true">🎤</span>
        <span>{t('footer.addRecipe')}</span>
        <span class="text-cream/40">· {t('footer.addRecipeHint')}</span>
      </a>
      <p>{t('footer.fromRanch')}</p>
    </div>
  </div>
</footer>
