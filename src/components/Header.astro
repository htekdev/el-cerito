---
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/recetas', label: 'Recetas' },
  { href: '/recetas?health=saludables', label: 'Saludables' },
  { href: '/nosotros', label: 'El Rancho' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 bg-cream/90 backdrop-blur border-b border-clay">
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2 group" aria-label="El Cerito — inicio">
      <span class="grid place-items-center h-9 w-9 rounded-full bg-terracotta text-cream text-lg shadow-sm group-hover:bg-terracotta-dark transition-colors">🌾</span>
      <span class="font-heading text-xl font-bold text-earth tracking-tight">El Cerito</span>
    </a>

    <ul class="hidden md:flex items-center gap-1">
      {nav.map((item) => {
        const active = item.href === '/' ? path === '/' : path.startsWith(item.href.split('?')[0]) && item.href !== '/';
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-lg text-sm font-semibold transition-colors',
                active ? 'text-terracotta-dark bg-terracotta-light/15' : 'text-earth-soft hover:text-terracotta-dark hover:bg-clay/50',
              ]}
            >{item.label}</a>
          </li>
        );
      })}
    </ul>

    <button id="menu-toggle" class="md:hidden grid place-items-center h-10 w-10 rounded-lg text-earth hover:bg-clay/60" aria-label="Abrir menú" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-clay bg-cream px-4 pb-4">
    <ul class="flex flex-col gap-1 pt-2">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-earth-soft hover:text-terracotta-dark hover:bg-clay/50">{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
