---
import type { CollectionEntry } from 'astro:content';
import { getEntry, render } from 'astro:content';
import {
  CATEGORIES, HEALTH_LABELS, categoryLabel, healthLabel, difficultyLabel,
  formatMinutes, totalTime, formatAmount, niceRound,
} from '../../lib/nutrition';
import {
  useTranslations, recipePath,
  rTitle, rDescription, rServingLabel, rIngredientName, rIngredientNote,
  rInstructions, rStory, rAltLabel, rSteps, buildGroceryList,
} from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  entry: CollectionEntry<'recipes'>;
  lang?: Lang;
}
const { entry, lang = 'es' } = Astro.props;
const d = entry.data;
const t = useTranslations(lang);
const { Content } = await render(entry);

const title = rTitle(d, lang);
const description = rDescription(d, lang);
const servingLabel = rServingLabel(d, lang);
const instructions = rInstructions(d, lang);
// Rich step-grouped instructions (null → fall back to flat `instructions`)
const steps = rSteps(d, d.ingredients, lang);
// Auto-generated grocery list (deduplicated names, no measurements)
const grocery = buildGroceryList(d.ingredients, lang);
const story = rStory(d, lang);
const time = totalTime(d.prepTime, d.cookTime, d.totalTime);

// Resolve healthier alternative references to real recipe data (localized)
const alternatives = await Promise.all(
  d.healthierAlternatives.map(async (alt) => {
    const target = await getEntry(alt.recipe);
    return target
      ? {
          slug: target.id,
          title: rTitle(target.data, lang),
          label: rAltLabel(alt, lang),
          calories: target.data.macros.calories,
        }
      : null;
  }),
);

// Data payload for client-side scaling
const recipeData = {
  slug: entry.id,
  defaultServings: d.servings,
  macros: d.macros,
  ingredients: d.ingredients.map((i) => ({ amount: i.amount, unit: i.unit })),
};

const macroRows = [
  { key: 'calories', label: t('recipe.mCalories'), unit: 'kcal', value: d.macros.calories },
  { key: 'protein', label: t('recipe.mProtein'), unit: 'g', value: d.macros.protein },
  { key: 'carbs', label: t('recipe.mCarbs'), unit: 'g', value: d.macros.carbs },
  { key: 'fat', label: t('recipe.mFat'), unit: 'g', value: d.macros.fat },
  { key: 'fiber', label: t('recipe.mFiber'), unit: 'g', value: d.macros.fiber ?? 0 },
];

// Title shown as a secondary line (the other language's title, if present)
const altTitleLine = lang === 'es' ? d.titleEn : d.title;
const storyParagraphs = story ? story.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];
---
<article>
  <!-- Recipe structured data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Recipe',
    inLanguage: lang === 'en' ? 'en-US' : 'es-MX',
    name: title,
    description: description,
    image: new URL(d.coverImage, Astro.site).href,
    author: { '@type': 'Organization', name: d.author },
    datePublished: d.pubDate.toISOString(),
    recipeCategory: d.categories.map((c) => categoryLabel(c, lang)).filter(Boolean),
    keywords: d.tags.join(', '),
    recipeYield: `${d.servings} ${servingLabel}`,
    prepTime: `PT${d.prepTime}M`,
    cookTime: `PT${d.cookTime}M`,
    totalTime: `PT${time}M`,
    recipeIngredient: d.ingredients.map((i) => `${i.amount} ${i.unit} ${rIngredientName(i, lang)}`),
    recipeInstructions: instructions.map((step, idx) => ({
      '@type': 'HowToStep', position: idx + 1, text: step,
    })),
    nutrition: {
      '@type': 'NutritionInformation',
      calories: `${d.macros.calories} kcal`,
      proteinContent: `${d.macros.protein} g`,
      carbohydrateContent: `${d.macros.carbs} g`,
      fatContent: `${d.macros.fat} g`,
      fiberContent: `${d.macros.fiber ?? 0} g`,
    },
  })} />

  <!-- Hero -->
  <div class="relative">
    <div class="aspect-[16/10] sm:aspect-[21/9] w-full overflow-hidden bg-clay">
      <img src={d.coverImage} alt={d.coverImageAlt || title} class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-earth/70 via-earth/10 to-transparent"></div>
    </div>
    <div class="absolute bottom-0 inset-x-0">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 pb-6 sm:pb-8">
        <div class="flex flex-wrap gap-2 mb-3">
          {d.ranchOriginal && (
            <span class="rounded-full bg-earth/85 text-cream text-xs font-semibold px-3 py-1 backdrop-blur">🌾 {t('recipe.fromRanch')}</span>
          )}
          {d.categories.map((c) => CATEGORIES[c] && (
            <span class="rounded-full bg-cream/90 text-earth text-xs font-semibold px-3 py-1 backdrop-blur">{CATEGORIES[c].icon} {categoryLabel(c, lang)}</span>
          ))}
        </div>
        <h1 class="font-heading text-3xl sm:text-5xl font-bold text-cream drop-shadow-sm">{title}</h1>
        {altTitleLine && <p class="text-cream/80 text-sm mt-1 italic">{altTitleLine}</p>}
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 mt-6">
    <p class="text-lg text-earth-soft leading-relaxed">{description}</p>

    <!-- Meta strip -->
    <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="rounded-xl bg-white border border-clay p-4 text-center">
        <div class="text-xs text-earth-soft uppercase tracking-wide">{t('recipe.prep')}</div>
        <div class="font-heading text-lg font-bold text-earth mt-0.5">{formatMinutes(d.prepTime)}</div>
      </div>
      <div class="rounded-xl bg-white border border-clay p-4 text-center">
        <div class="text-xs text-earth-soft uppercase tracking-wide">{t('recipe.cook')}</div>
        <div class="font-heading text-lg font-bold text-earth mt-0.5">{formatMinutes(d.cookTime)}</div>
      </div>
      <div class="rounded-xl bg-white border border-clay p-4 text-center">
        <div class="text-xs text-earth-soft uppercase tracking-wide">{t('recipe.total')}</div>
        <div class="font-heading text-lg font-bold text-terracotta-dark mt-0.5">{formatMinutes(time)}</div>
      </div>
      <div class="rounded-xl bg-white border border-clay p-4 text-center">
        <div class="text-xs text-earth-soft uppercase tracking-wide">{t('recipe.difficulty')}</div>
        <div class="font-heading text-lg font-bold text-earth mt-0.5">{difficultyLabel(d.difficulty, lang)}</div>
      </div>
    </div>

    {d.healthLabels.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {d.healthLabels.map((label) => HEALTH_LABELS[label] && (
          <span class:list={['rounded-full px-3 py-1 text-xs font-semibold', HEALTH_LABELS[label].color]}>
            {HEALTH_LABELS[label].icon} {healthLabel(label, lang)}
          </span>
        ))}
      </div>
    )}

    <!-- Healthier alternatives -->
    {alternatives.filter(Boolean).length > 0 && (
      <div class="mt-6 rounded-2xl border border-sage-light bg-sage-light/15 p-5">
        <h2 class="font-heading text-lg font-bold text-sage-dark flex items-center gap-2">🌱 {t('recipe.healthierTitle')}</h2>
        <ul class="mt-3 space-y-2">
          {alternatives.filter(Boolean).map((alt) => (
            <li>
              <a href={recipePath(lang, alt!.slug)} class="group flex items-center justify-between gap-3 rounded-xl bg-white/70 hover:bg-white border border-sage-light/60 px-4 py-3 transition-colors">
                <div>
                  <div class="font-semibold text-earth group-hover:text-sage-dark">{alt!.title}</div>
                  <div class="text-sm text-earth-soft">{alt!.label}</div>
                </div>
                <span class="shrink-0 text-sm font-bold text-sage-dark">{alt!.calories} kcal →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Grocery list — what to BUY (deduplicated, no measurements) -->
  <div class="mx-auto max-w-4xl px-4 sm:px-6 mt-10">
    <div class="rounded-2xl border border-honey/50 bg-honey/10 overflow-hidden">
      <div class="flex items-start gap-3 px-5 pt-5">
        <span class="text-2xl leading-none">🛒</span>
        <div class="min-w-0">
          <h2 class="font-heading text-2xl font-bold text-earth">{t('recipe.groceryList')}</h2>
          <p class="text-sm text-earth-soft">{t('recipe.grocerySubtitle')} · {t('recipe.groceryHint')}</p>
        </div>
      </div>
      <ul id="grocery-list" class="mt-4 px-3 pb-4 grid sm:grid-cols-2 gap-1">
        {grocery.map((item, idx) => (
          <li>
            <label class="grocery-item flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-white/60 cursor-pointer transition-colors" data-grocery={idx}>
              <input type="checkbox" class="grocery-check peer sr-only" />
              <span class="shrink-0 grid place-items-center h-6 w-6 rounded-md border-2 border-honey bg-white text-cream peer-checked:bg-sage peer-checked:border-sage transition-colors">
                <svg class="h-4 w-4 opacity-0 peer-checked:opacity-100 transition-opacity" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3"><path d="M4 10l4 4 8-9" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="grocery-name text-earth peer-checked:text-earth-soft peer-checked:line-through transition-colors">
                {item.amount !== null && (
                  <span class="font-semibold text-terracotta-dark tabular-nums mr-1">
                    <span class="grocery-amount" data-base={item.amount}>{formatAmount(item.amount, 1)}</span>
                    {item.unit && <span class="text-earth-soft font-normal text-sm"> {item.unit}</span>}
                  </span>
                )}
                {item.name}
                {item.optional && <span class="text-xs text-sage-dark ml-1">{t('recipe.optional')}</span>}
              </span>
            </label>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Serving adjuster + ingredients + macros -->
  <div class="mx-auto max-w-4xl px-4 sm:px-6 mt-10 grid gap-8 lg:grid-cols-5">
    <!-- Left: ingredients -->
    <div class="lg:col-span-3">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <h2 class="font-heading text-2xl font-bold text-earth">{t('recipe.ingredients')}</h2>
        <!-- Serving stepper -->
        <div class="inline-flex items-center gap-2 rounded-full bg-white border border-clay p-1 shadow-sm">
          <button id="serv-minus" class="grid place-items-center h-9 w-9 rounded-full bg-cream-dark hover:bg-terracotta hover:text-cream text-earth font-bold text-lg transition-colors" aria-label={t('recipe.servMinus')}>−</button>
          <div class="px-2 text-center min-w-[5.5rem]">
            <span id="serv-count" class="font-heading text-xl font-bold text-terracotta-dark">{d.servings}</span>
            <span class="text-sm text-earth-soft block leading-none">{servingLabel}</span>
          </div>
          <button id="serv-plus" class="grid place-items-center h-9 w-9 rounded-full bg-cream-dark hover:bg-terracotta hover:text-cream text-earth font-bold text-lg transition-colors" aria-label={t('recipe.servPlus')}>+</button>
        </div>
      </div>

      <ul class="mt-4 divide-y divide-clay/70 rounded-2xl bg-white border border-clay overflow-hidden">
        {d.ingredients.map((ing, idx) => {
          const note = rIngredientNote(ing, lang);
          return (
            <li class="flex items-baseline gap-3 px-4 py-3">
              <span class="shrink-0 tabular-nums font-semibold text-terracotta-dark min-w-[4.5rem]">
                <span class="ing-amount" data-idx={idx}>{ing.unit === 'to taste' ? '' : formatAmount(ing.amount, 1)}</span>
                <span class="text-earth-soft font-normal text-sm"> {ing.unit === 'to taste' ? t('recipe.toTaste') : ing.unit}</span>
              </span>
              <span class="text-earth">
                {rIngredientName(ing, lang)}
                {note && <span class="text-earth-soft text-sm"> — {note}</span>}
                {ing.optional && <span class="text-xs text-sage-dark ml-1">{t('recipe.optional')}</span>}
              </span>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Right: nutrition -->
    <div class="lg:col-span-2">
      <h2 class="font-heading text-2xl font-bold text-earth">{t('recipe.nutrition')}</h2>
      <div class="mt-4 rounded-2xl bg-white border border-clay overflow-hidden">
        <div class="grid grid-cols-2 text-center text-xs font-semibold text-earth-soft bg-cream-dark">
          <div class="py-2 border-r border-clay">{t('recipe.perServing')}</div>
          <div class="py-2">{t('recipe.totalCol')} (<span id="macro-serv">{d.servings}</span>)</div>
        </div>
        <ul>
          {macroRows.map((row) => (
            <li class="grid grid-cols-2 items-center border-t border-clay/70">
              <div class="px-4 py-2.5">
                <div class="text-sm text-earth-soft">{row.label}</div>
                <div class="font-heading font-bold text-earth">{niceRound(row.value)} <span class="text-xs font-normal text-earth-soft">{row.unit}</span></div>
              </div>
              <div class="px-4 py-2.5 text-center bg-cream/50 h-full flex flex-col justify-center">
                <div class="font-heading font-bold text-terracotta-dark tabular-nums">
                  <span class="macro-total" data-key={row.key}>{niceRound(row.value * d.servings)}</span>
                  <span class="text-xs font-normal text-earth-soft"> {row.unit}</span>
                </div>
              </div>
            </li>
          ))}
        </ul>
        <p class="px-4 py-3 text-xs text-earth-soft bg-cream-dark border-t border-clay">
          {t('recipe.macroNote')}
        </p>
      </div>
    </div>
  </div>

  <!-- Instructions -->
  <div class="mx-auto max-w-4xl px-4 sm:px-6 mt-12">
    <div class="flex items-baseline justify-between flex-wrap gap-x-4 gap-y-1">
      <h2 class="font-heading text-2xl font-bold text-earth">{t('recipe.instructions')}</h2>
      {steps && <p class="text-sm text-earth-soft max-w-md">{t('recipe.stepsHint')}</p>}
    </div>

    {steps ? (
      <!-- Step-grouped layout: each step carries its own ingredients + measurements -->
      <ol class="mt-6 space-y-5">
        {steps.map((step, idx) => (
          <li class="rounded-2xl bg-white border border-clay overflow-hidden">
            <div class="flex gap-4 p-4 sm:p-5">
              <span class="shrink-0 grid place-items-center h-9 w-9 rounded-full bg-terracotta text-cream font-heading font-bold">{idx + 1}</span>
              <div class="min-w-0 flex-1">
                {step.title && <h3 class="font-heading text-lg font-bold text-earth leading-tight">{step.title}</h3>}
                {step.ingredients.length > 0 && (
                  <div class="mt-2 rounded-xl bg-cream/70 border border-clay/60 px-3 py-2.5">
                    <div class="text-[0.7rem] font-semibold uppercase tracking-wide text-terracotta-dark flex items-center gap-1">
                      <span>📋</span> {t('recipe.stepNeeds')}
                    </div>
                    <ul class="mt-1.5 flex flex-wrap gap-1.5">
                      {step.ingredients.map((si) => (
                        <li class="inline-flex items-baseline gap-1 rounded-full bg-white border border-clay px-2.5 py-1 text-sm">
                          {si.amountLabel ? (
                            <span class="font-semibold text-terracotta-dark tabular-nums">{si.amountLabel}</span>
                          ) : si.amount !== null ? (
                            <span class="font-semibold text-terracotta-dark tabular-nums">
                              <span class="ing-amount" data-idx={si.refIdx}>{formatAmount(si.amount, 1)}</span>
                              {si.unit && si.unit !== 'to taste' && <span class="text-earth-soft font-normal text-xs"> {si.unit}</span>}
                            </span>
                          ) : null}
                          <span class="text-earth">{si.name}</span>
                          {si.note && <span class="text-earth-soft text-xs">({si.note})</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                <p class="text-earth leading-relaxed mt-2.5">{step.text}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <!-- Flat fallback: classic numbered instruction list -->
      <ol class="mt-5 space-y-4">
        {instructions.map((step, idx) => (
          <li class="flex gap-4">
            <span class="shrink-0 grid place-items-center h-9 w-9 rounded-full bg-terracotta text-cream font-heading font-bold">{idx + 1}</span>
            <p class="text-earth leading-relaxed pt-1">{step}</p>
          </li>
        ))}
      </ol>
    )}
  </div>

  <!-- Story / body -->
  <div class="mx-auto max-w-4xl px-4 sm:px-6 mt-10 prose prose-earth max-w-none text-earth-soft leading-relaxed">
    {lang === 'es'
      ? <Content />
      : storyParagraphs.map((p) => <p>{p}</p>)}
  </div>

  {d.tags.length > 0 && (
    <div class="mx-auto max-w-4xl px-4 sm:px-6 mt-10 flex flex-wrap gap-2">
      {d.tags.map((tag) => (
        <span class="rounded-full bg-clay/70 text-earth-soft text-xs font-medium px-3 py-1">#{tag}</span>
      ))}
    </div>
  )}

  <div class="mx-auto max-w-4xl px-4 sm:px-6 mt-12 mb-8">
    <a href={recipePath(lang, '').replace(/\/$/, '')} class="inline-flex items-center gap-2 text-terracotta-dark font-semibold hover:gap-3 transition-all">← {t('recipe.backToAll')}</a>
  </div>
</article>

<script type="application/json" id="recipe-data" set:html={JSON.stringify(recipeData)}></script>

<script>
  const el = document.getElementById('recipe-data');
  if (el) {
    const data = JSON.parse(el.textContent || '{}');
    const def = data.defaultServings || 1;
    let servings = def;

    const countEl = document.getElementById('serv-count');
    const macroServEl = document.getElementById('macro-serv');
    const amounts = Array.from(document.querySelectorAll('.ing-amount'));
    const totals = Array.from(document.querySelectorAll('.macro-total'));
    const groceryAmounts = Array.from(document.querySelectorAll('.grocery-amount'));

    const niceRound = (v: number) => (!isFinite(v) ? 0 : v >= 10 ? Math.round(v) : Math.round(v * 10) / 10);
    const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));

    function render() {
      const factor = servings / def;
      if (countEl) countEl.textContent = String(servings);
      if (macroServEl) macroServEl.textContent = String(servings);

      amounts.forEach((node) => {
        const idx = Number((node as HTMLElement).dataset.idx);
        const ing = data.ingredients[idx];
        if (!ing || ing.unit === 'to taste') return;
        node.textContent = fmt(niceRound(ing.amount * factor));
      });

      totals.forEach((node) => {
        const key = (node as HTMLElement).dataset.key as string;
        const perServing = data.macros[key] ?? 0;
        node.textContent = String(niceRound(perServing * servings));
      });

      groceryAmounts.forEach((node) => {
        const base = Number((node as HTMLElement).dataset.base);
        if (!isFinite(base)) return;
        node.textContent = fmt(niceRound(base * factor));
      });
    }

    document.getElementById('serv-minus')?.addEventListener('click', () => {
      if (servings > 1) { servings -= 1; render(); }
    });
    document.getElementById('serv-plus')?.addEventListener('click', () => {
      if (servings < 50) { servings += 1; render(); }
    });

    render();

    // ── Grocery checklist: persist checked items per recipe ──────────────
    const groceryKey = `elcerito:grocery:${data.slug || location.pathname}`;
    const groceryChecks = Array.from(
      document.querySelectorAll<HTMLInputElement>('.grocery-check'),
    );
    if (groceryChecks.length) {
      let checked: Record<string, boolean> = {};
      try { checked = JSON.parse(localStorage.getItem(groceryKey) || '{}'); } catch {}
      groceryChecks.forEach((input) => {
        const item = input.closest('.grocery-item') as HTMLElement | null;
        const id = item?.dataset.grocery;
        if (id === undefined) return;
        input.checked = checked[id] === true;
        input.addEventListener('change', () => {
          checked[id] = input.checked;
          try { localStorage.setItem(groceryKey, JSON.stringify(checked)); } catch {}
        });
      });
    }
  }
</script>
